"Language: es\n"

# Founding narrative (es) — extract from FounderNarrativeCatalog.cs
# All keys used by the AstralOnboardingView, resolved at runtime
# via LocaleManager.Translate(key).

# Q("hand", ...)
msgid "narrative.hand.title"
msgstr "La mano que se aleja"

msgid "narrative.hand.body"
msgstr ""
"El camino se parte entre ambos.\n"
"La otra figura comienza a alejarse, arrastrada hacia una oscuridad distinta.\n"
"Solo queda tiempo para un movimiento."

msgid "narrative.hand.option.hold.label"
msgstr "Aferrarme a su mano mientras todavía pueda sentirla."

msgid "narrative.hand.option.hold.consequence"
msgstr "La presión dura un instante más. Después, la distancia vuelve a crecer."

msgid "narrative.hand.option.observe.label"
msgstr "Observar la dirección, la distancia y cada cambio de la fractura."

msgid "narrative.hand.option.observe.consequence"
msgstr "La separación continúa, pero su trayectoria queda grabada."

msgid "narrative.hand.option.stabilise.label"
msgstr "Intentar estabilizar el camino antes de que termine de dividirse."

msgid "narrative.hand.option.stabilise.consequence"
msgstr "Los bordes obedecen durante un pulso. No es suficiente, pero fue real."

msgid "narrative.hand.option.call.label"
msgstr "Hacer que escuche dónde intentaré volver a encontrarle."

msgid "narrative.hand.option.call.consequence"
msgstr "Tu intención atraviesa la fractura, aunque no sabes qué parte llegó."

# Q("word", ...)
msgid "narrative.word.title"
msgstr "La palabra que no termina"

msgid "narrative.word.body"
msgstr ""
"Su voz todavía logra atravesar la fractura, pero las palabras llegan deformadas.\n"
"Solo una parece conservar significado."

msgid "narrative.word.option.find.label"
msgstr "«Encuéntrame.»"

msgid "narrative.word.option.find.consequence"
msgstr "La palabra se convierte en dirección, aunque no promete llegada."

msgid "narrative.word.option.return.label"
msgstr "«Regresa.»"

msgid "narrative.word.option.return.consequence"
msgstr "Algo en ti se orienta hacia lo perdido."

msgid "narrative.word.option.remember.label"
msgstr "«Recuerda.»"

msgid "narrative.word.option.remember.consequence"
msgstr "Los recuerdos dejan de ser ruido y se aferran unos a otros."

msgid "narrative.word.option.continue.label"
msgstr "«Continúa.»"

msgid "narrative.word.option.continue.consequence"
msgstr "La fractura ya no parece una orden de detenerte."

# Q("detail", ...)
msgid "narrative.detail.title"
msgstr "El último detalle intacto"

msgid "narrative.detail.body"
msgstr ""
"Su silueta desaparece.\n"
"La memoria permanece, pero ya no puede conservarlo todo con la misma claridad.\n"
"Un detalle se niega a desvanecerse."

msgid "narrative.detail.option.name.label"
msgstr "La forma en que pronunciaba mi nombre."

msgid "narrative.detail.option.name.consequence"
msgstr "Tu identidad adquiere un borde al ser recordada por otra voz."

msgid "narrative.detail.option.hands.label"
msgstr "El movimiento de sus manos cuando reparábamos algo juntos."

msgid "narrative.detail.option.hands.consequence"
msgstr "Un gesto repetido reconstruye la idea de una obra compartida."

msgid "narrative.detail.option.object.label"
msgstr "El peso del objeto que ambos reconocíamos como nuestro."

msgid "narrative.detail.option.object.consequence"
msgstr "La memoria del objeto introduce una palabra nueva: peso."

msgid "narrative.detail.option.journey.label"
msgstr "La sensación de avanzar juntos sin conocer el destino."

msgid "narrative.detail.option.journey.consequence"
msgstr "El destino desaparece; el movimiento compartido no."

# Q("old-form", ...)
msgid "narrative.old-form.title"
msgstr "La forma que queda atrás"

msgid "narrative.old-form.body"
msgstr ""
"Dejas de sentir rostro, manos y respiración.\n"
"Tu antigua forma ya no puede acompañarte.\n"
"Aferrarte a ella podría arrastrar consigo lo que todavía permanece."

msgid "narrative.old-form.option.exact.label"
msgstr "Conservar su forma exacta mientras sea posible."

msgid "narrative.old-form.option.exact.consequence"
msgstr "La forma resiste como un contorno bajo presión."

msgid "narrative.old-form.option.sensation.label"
msgstr "Conservar únicamente las sensaciones que alguna vez produjo."

msgid "narrative.old-form.option.sensation.consequence"
msgstr "El contorno desaparece; la sensibilidad queda."

msgid "narrative.old-form.option.separate.label"
msgstr "Separar mi identidad de cualquier cuerpo que haya tenido."

msgid "narrative.old-form.option.separate.consequence"
msgstr "La identidad permanece sin necesitar una silueta."

msgid "narrative.old-form.option.release.label"
msgstr "Permitir que desaparezca para poder adoptar algo nuevo."

msgid "narrative.old-form.option.release.consequence"
msgstr "La antigua forma se disuelve sin llevarse la memoria."

# Q("time", ...)
msgid "narrative.time.title"
msgstr "El tiempo adquiere orden"

msgid "narrative.time.body"
msgstr ""
"Antes, todos tus recuerdos podían existir al mismo tiempo.\n"
"Ahora comienzan a colocarse unos detrás de otros.\n"
"Para conservarlos debes aceptar una manera de ordenarlos."

msgid "narrative.time.option.cause.label"
msgstr "Por aquello que ocurrió primero y lo que provocó después."

msgid "narrative.time.option.cause.consequence"
msgstr "Los recuerdos forman una cadena de causas."

msgid "narrative.time.option.feeling.label"
msgstr "Por la intensidad de lo que sentí en cada momento."

msgid "narrative.time.option.feeling.consequence"
msgstr "La intensidad se convierte en un reloj imperfecto."

msgid "narrative.time.option.promises.label"
msgstr "Por las promesas, acuerdos y deudas que dejaron entre nosotros."

msgid "narrative.time.option.promises.consequence"
msgstr "Cada acuerdo ocupa un lugar que no puede intercambiarse."

msgid "narrative.time.option.places.label"
msgstr "Por los lugares atravesados y los caminos que los conectaban."

msgid "narrative.time.option.places.consequence"
msgstr "La memoria se despliega como una ruta."

# Q("mortality", ...)
msgid "narrative.mortality.title"
msgstr "La primera frontera"

msgid "narrative.mortality.body"
msgstr ""
"Algo introduce una idea imposible dentro de tu conciencia:\n"
"la forma que recibirás tendrá un final."

msgid "narrative.mortality.option.weight.label"
msgstr "Entonces cada decisión tendrá un peso que antes no tenía."

msgid "narrative.mortality.option.weight.consequence"
msgstr "La irreversibilidad convierte intención en responsabilidad."

msgid "narrative.mortality.option.understand.label"
msgstr "Entonces debo comprender ese límite antes de aceptarlo."

msgid "narrative.mortality.option.understand.consequence"
msgstr "El límite se mantiene delante de ti como una pregunta."

msgid "narrative.mortality.option.others.label"
msgstr "Entonces habrá que aprender a permanecer a través de otros."

msgid "narrative.mortality.option.others.consequence"
msgstr "La continuidad deja de ser individual."

msgid "narrative.mortality.option.new.label"
msgstr "Entonces también será posible comenzar de una forma completamente nueva."

msgid "narrative.mortality.option.new.consequence"
msgstr "El final contiene, por primera vez, la idea de un comienzo."

# Q("world", ...)
msgid "narrative.world.title"
msgstr "El mundo te alcanza"

msgid "narrative.world.body"
msgstr ""
"Por primera vez algo ajeno al tránsito toca tu conciencia.\n"
"No tiene voz, pero puede sentirse de varias maneras.\n"
"Una de ellas logra atravesarte con mayor claridad."

msgid "narrative.world.option.earth.label"
msgstr "Un peso que evita que mis fragmentos se dispersen."

msgid "narrative.world.option.earth.consequence"
msgstr "La presencia sostiene tus fragmentos."

msgid "narrative.world.option.water.label"
msgstr "Un flujo que cambia de forma sin perder continuidad."

msgid "narrative.world.option.water.consequence"
msgstr "La presencia se adapta sin desaparecer."

msgid "narrative.world.option.fire.label"
msgstr "Una temperatura que transforma aquello que toca."

msgid "narrative.world.option.fire.consequence"
msgstr "La presencia altera el borde de tu nueva forma."

msgid "narrative.world.option.air.label"
msgstr "Una corriente que encuentra una salida donde no parecía existir."

msgid "narrative.world.option.air.consequence"
msgstr "La presencia convierte el cierre en ruta."

msgid "narrative.world.option.aether.label"
msgstr "Una relación invisible entre fragmentos separados."

msgid "narrative.world.option.aether.consequence"
msgstr "La presencia conecta sin tocar."

msgid "narrative.world.option.none.label"
msgstr "Un silencio que no exige adoptar ninguna afinidad."

msgid "narrative.world.option.none.consequence"
msgstr "La presencia permite que el silencio permanezca."

# Q("perception", ...)
msgid "narrative.perception.title"
msgstr "Lo primero que reconoce la nueva forma"

msgid "narrative.perception.body"
msgstr ""
"Algo comienza a organizarse alrededor de tu conciencia.\n"
"Todavía no es un cuerpo completo.\n"
"Sin embargo, una percepción aparece antes que las demás."

msgid "narrative.perception.option.ardhen.label"
msgstr "El peso, la resistencia y el esfuerzo necesario para mover algo."

msgid "narrative.perception.option.ardhen.consequence"
msgstr "La forma aprende esfuerzo antes que movimiento."

msgid "narrative.perception.option.eirune.label"
msgstr "Los pulsos, heridas y ciclos que mantienen viva una forma."

msgid "narrative.perception.option.eirune.consequence"
msgstr "La forma reconoce que estar viva exige continuidad."

msgid "narrative.perception.option.kovari.label"
msgstr "Los ritmos, uniones y fallos que permiten desmontar un sistema."

msgid "narrative.perception.option.kovari.consequence"
msgstr "La forma distingue piezas donde antes solo había totalidad."

msgid "narrative.perception.option.myrven.label"
msgstr "Los gestos, contradicciones y significados que existen entre identidades."

msgid "narrative.perception.option.myrven.consequence"
msgstr "La forma reconoce que un rostro nunca contiene una sola lectura."

# Q("orientation", ...)
msgid "narrative.orientation.title"
msgstr "La nueva forma busca orientación"

msgid "narrative.orientation.body"
msgstr ""
"La estructura continúa completándose.\n"
"Para no perderse necesita reconocer una relación fundamental con lo que la rodea."

msgid "narrative.orientation.option.vaelun.label"
msgstr "La distancia entre un lugar, un camino y la posibilidad de regresar."

msgid "narrative.orientation.option.vaelun.consequence"
msgstr "La forma encuentra dirección en la posibilidad del retorno."

msgid "narrative.orientation.option.orveth.label"
msgstr "El equilibrio entre aquello que se necesita, se conserva y se entrega."

msgid "narrative.orientation.option.orveth.consequence"
msgstr "La forma reconoce una reserva y su posible destinatario."

msgid "narrative.orientation.option.caelith.label"
msgstr "Las conexiones que permiten convertir fragmentos en conocimiento."

msgid "narrative.orientation.option.caelith.consequence"
msgstr "La forma enlaza observaciones que separadas no bastaban."

msgid "narrative.orientation.option.theryn.label"
msgstr "El estado emocional que mantiene unido o separa a un grupo."

msgid "narrative.orientation.option.theryn.consequence"
msgstr "La forma percibe tensión incluso sin conocer todavía a un grupo."

# Q("threshold", ...)
msgid "narrative.threshold.title"
msgstr "El umbral se resiste"

msgid "narrative.threshold.body"
msgstr ""
"La salida hacia el plano terrenal comienza a cerrarse.\n"
"No es una criatura ni una voluntad.\n"
"Es una fuerza que ocupa todo el espacio por el que debes atravesar."

msgid "narrative.threshold.option.support.label"
msgstr "Sostener su presión hasta que la abertura vuelva a estabilizarse."

msgid "narrative.threshold.option.support.consequence"
msgstr "La abertura tiembla, sostenida por tu resistencia."

msgid "narrative.threshold.option.control.label"
msgstr "Fijar límites y obligarla a desplazarse dentro de un espacio controlado."

msgid "narrative.threshold.option.control.consequence"
msgstr "El umbral cede dentro de límites que no esperaba."

msgid "narrative.threshold.option.mobility.label"
msgstr "Seguir su movimiento hasta encontrar una ruta alrededor."

msgid "narrative.threshold.option.mobility.consequence"
msgstr "La resistencia se convierte en un trayecto."

msgid "narrative.threshold.option.precision.label"
msgstr "Esperar hasta comprender el patrón exacto de su debilidad."

msgid "narrative.threshold.option.precision.consequence"
msgstr "El patrón aparece justo antes de desaparecer."

msgid "narrative.threshold.option.assault.label"
msgstr "Atravesarla antes de que tenga tiempo de cerrarse por completo."

msgid "narrative.threshold.option.assault.consequence"
msgstr "La fuerza te alcanza tarde; ya estás al otro lado."

# Q("ground", ...)
msgid "narrative.ground.title"
msgstr "El peso bajo tus pies"

msgid "narrative.ground.body"
msgstr ""
"Algo aparece debajo de ti.\n"
"Todavía está demasiado lejos para llamarlo suelo.\n"
"Por primera vez comprendes que el impacto podría destruir parte de lo que has conservado."

msgid "narrative.ground.option.clarity.label"
msgstr "Proteger la claridad de mi conciencia."

msgid "narrative.ground.option.clarity.consequence"
msgstr "Tus recuerdos se cierran alrededor de un núcleo estable."

msgid "narrative.ground.option.shared.label"
msgstr "Proteger el objeto o fragmento que compartíamos."

msgid "narrative.ground.option.shared.consequence"
msgstr "El fragmento ocupa el centro de tu caída."

msgid "narrative.ground.option.move.label"
msgstr "Conservar la capacidad de moverme cuando todo termine."

msgid "narrative.ground.option.move.consequence"
msgstr "La forma reserva movimiento para después del impacto."

msgid "narrative.ground.option.mark.label"
msgstr "Dejar una marca que permita reconocer el lugar exacto de mi llegada."

msgid "narrative.ground.option.mark.consequence"
msgstr "El punto de caída adquiere una coordenada y una intención."

# Q("unchanged", ...)
msgid "narrative.unchanged.title"
msgstr "Aquello que no debe cambiar"

msgid "narrative.unchanged.body"
msgstr ""
"La forma está casi completa.\n"
"Tendrá otro rostro, otra voz y necesidades que nunca has conocido.\n"
"Si todo lo demás puede cambiar, algo debe seguir siendo reconocible."

msgid "narrative.unchanged.option.protect.label"
msgstr "Aquello que decido proteger."

msgid "narrative.unchanged.option.protect.consequence"
msgstr "La nueva forma encuentra un límite que está dispuesta a sostener."

msgid "narrative.unchanged.option.freedom.label"
msgstr "La libertad de elegir en quién puedo convertirme."

msgid "narrative.unchanged.option.freedom.consequence"
msgstr "La forma termina de cerrarse sin cerrar tus posibilidades."

msgid "narrative.unchanged.option.understand.label"
msgstr "La necesidad de comprender antes de aceptar una respuesta."

msgid "narrative.unchanged.option.understand.consequence"
msgstr "La pregunta permanece incluso cuando la forma deja de cambiar."

msgid "narrative.unchanged.option.paths.label"
msgstr "La forma en que encuentro caminos incluso después de perderlos."

msgid "narrative.unchanged.option.paths.consequence"
msgstr "El terreno deja de ser una mancha y comienza a parecer un lugar."

