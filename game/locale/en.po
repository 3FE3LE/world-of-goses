msgstr ""
"Content-Type: text/plain; charset=UTF-8\n"
"Language: en\n"

# Founding narrative (en) — initial translation, pending native
# review. Each msgstr is the English counterpart of the Spanish msgstr
# in es.po. Reviewers: please mark any inaccurate translation with
# `# TODO (i18n):` and a comment so the next pass picks it up.

# Q("hand", ...)
msgid "narrative.hand.title"
msgstr "The hand that drifts away"

msgid "narrative.hand.body"
msgstr ""
"The path splits between the two of you.\n"
"The other figure begins to move away, dragged toward a different darkness.\n"
"Only one movement remains."

msgid "narrative.hand.option.hold.label"
msgstr "Hold their hand while I can still feel it."

msgid "narrative.hand.option.hold.consequence"
msgstr "The pressure lasts one more instant. Then the distance begins to grow again."

msgid "narrative.hand.option.observe.label"
msgstr "Observe the direction, the distance, every change in the fracture."

msgid "narrative.hand.option.observe.consequence"
msgstr "The separation continues, but its trajectory is recorded."

msgid "narrative.hand.option.stabilise.label"
msgstr "Try to stabilise the path before it finishes dividing."

msgid "narrative.hand.option.stabilise.consequence"
msgstr "The edges obey for one pulse. Not enough, but it was real."

msgid "narrative.hand.option.call.label"
msgstr "Make them hear where I will try to find them again."

msgid "narrative.hand.option.call.consequence"
msgstr "Your intent crosses the fracture, even if you do not know which part arrived."

# Q("word", ...)
msgid "narrative.word.title"
msgstr "The word that does not end"

msgid "narrative.word.body"
msgstr ""
"Their voice still manages to cross the fracture, but the words arrive deformed.\n"
"Only one seems to keep its meaning."

msgid "narrative.word.option.find.label"
msgstr "“Find me.”"

msgid "narrative.word.option.find.consequence"
msgstr "The word becomes a direction, even if it does not promise arrival."

msgid "narrative.word.option.return.label"
msgstr "“Come back.”"

msgid "narrative.word.option.return.consequence"
msgstr "Something in you orients toward what was lost."

msgid "narrative.word.option.remember.label"
msgstr "“Remember.”"

msgid "narrative.word.option.remember.consequence"
msgstr "The memories stop being noise and cling to each other."

msgid "narrative.word.option.continue.label"
msgstr "“Continue.”"

msgid "narrative.word.option.continue.consequence"
msgstr "The fracture no longer looks like a command to stop."

# Q("detail", ...)
msgid "narrative.detail.title"
msgstr "The last intact detail"

msgid "narrative.detail.body"
msgstr ""
"Their silhouette disappears.\n"
"Memory remains, but it can no longer hold everything with the same clarity.\n"
"One detail refuses to fade."

msgid "narrative.detail.option.name.label"
msgstr "The way they pronounced my name."

msgid "narrative.detail.option.name.consequence"
msgstr "Your identity acquires an edge by being remembered in another voice."

msgid "narrative.detail.option.hands.label"
msgstr "The movement of their hands when we fixed something together."

msgid "narrative.detail.option.hands.consequence"
msgstr "A repeated gesture reconstructs the idea of a shared work."

msgid "narrative.detail.option.object.label"
msgstr "The weight of the object we both recognised as ours."

msgid "narrative.detail.option.object.consequence"
msgstr "The memory of the object introduces a new word: weight."

msgid "narrative.detail.option.journey.label"
msgstr "The feeling of moving forward together without knowing the destination."

msgid "narrative.detail.option.journey.consequence"
msgstr "The destination disappears; the shared movement does not."

# Q("old-form", ...)
msgid "narrative.old-form.title"
msgstr "The form that remains behind"

msgid "narrative.old-form.body"
msgstr ""
"You stop feeling face, hands and breath.\n"
"Your old form can no longer accompany you.\n"
"Holding onto it might drag along what still remains."

msgid "narrative.old-form.option.exact.label"
msgstr "Keep its exact form for as long as possible."

msgid "narrative.old-form.option.exact.consequence"
msgstr "The form resists like an outline under pressure."

msgid "narrative.old-form.option.sensation.label"
msgstr "Keep only the sensations it once produced."

msgid "narrative.old-form.option.sensation.consequence"
msgstr "The outline disappears; the sensibility remains."

msgid "narrative.old-form.option.separate.label"
msgstr "Separate my identity from any body I have had."

msgid "narrative.old-form.option.separate.consequence"
msgstr "Identity remains without needing a silhouette."

msgid "narrative.old-form.option.release.label"
msgstr "Allow it to disappear so I can adopt something new."

msgid "narrative.old-form.option.release.consequence"
msgstr "The old form dissolves without taking the memory with it."

# Q("time", ...)
msgid "narrative.time.title"
msgstr "Time acquires order"

msgid "narrative.time.body"
msgstr ""
"Before, all your memories could exist at the same time.\n"
"Now they begin to place themselves one behind the other.\n"
"To keep them you must accept a way of ordering them."

msgid "narrative.time.option.cause.label"
msgstr "By what came first and what it caused afterwards."

msgid "narrative.time.option.cause.consequence"
msgstr "The memories form a chain of causes."

msgid "narrative.time.option.feeling.label"
msgstr "By the intensity of what I felt at each moment."

msgid "narrative.time.option.feeling.consequence"
msgstr "Intensity becomes an imperfect clock."

msgid "narrative.time.option.promises.label"
msgstr "By the promises, agreements and debts left between us."

msgid "narrative.time.option.promises.consequence"
msgstr "Each agreement occupies a place that cannot be exchanged."

msgid "narrative.time.option.places.label"
msgstr "By the places crossed and the paths that connected them."

msgid "narrative.time.option.places.consequence"
msgstr "Memory unfolds as a route."

# Q("mortality", ...)
msgid "narrative.mortality.title"
msgstr "The first frontier"

msgid "narrative.mortality.body"
msgstr ""
"Something introduces an impossible idea into your awareness:\n"
"the form you will receive will have an end."

msgid "narrative.mortality.option.weight.label"
msgstr "Then every decision will have a weight it did not have before."

msgid "narrative.mortality.option.weight.consequence"
msgstr "Irreversibility turns intention into responsibility."

msgid "narrative.mortality.option.understand.label"
msgstr "Then I must understand that limit before accepting it."

msgid "narrative.mortality.option.understand.consequence"
msgstr "The limit remains in front of you as a question."

msgid "narrative.mortality.option.others.label"
msgstr "Then I will have to learn to endure through others."

msgid "narrative.mortality.option.others.consequence"
msgstr "Continuity stops being individual."

msgid "narrative.mortality.option.new.label"
msgstr "Then it will also be possible to begin in a completely new way."

msgid "narrative.mortality.option.new.consequence"
msgstr "The ending contains, for the first time, the idea of a beginning."

# Q("world", ...)
msgid "narrative.world.title"
msgstr "The world reaches you"

msgid "narrative.world.body"
msgstr ""
"For the first time, something external to the crossing touches your awareness.\n"
"It has no voice, but it can be felt in several ways.\n"
"One of them reaches you more clearly than the rest."

msgid "narrative.world.option.earth.label"
msgstr "A weight that prevents my fragments from scattering."

msgid "narrative.world.option.earth.consequence"
msgstr "The presence holds your fragments together."

msgid "narrative.world.option.water.label"
msgstr "A flow that changes shape without losing continuity."

msgid "narrative.world.option.water.consequence"
msgstr "The presence adapts without disappearing."

msgid "narrative.world.option.fire.label"
msgstr "A temperature that transforms what it touches."

msgid "narrative.world.option.fire.consequence"
msgstr "The presence alters the edge of your new form."

msgid "narrative.world.option.air.label"
msgstr "A current that finds an exit where none seemed to exist."

msgid "narrative.world.option.air.consequence"
msgstr "The presence turns a closing into a route."

msgid "narrative.world.option.aether.label"
msgstr "An invisible relation between separated fragments."

msgid "narrative.world.option.aether.consequence"
msgstr "The presence connects without touching."

msgid "narrative.world.option.none.label"
msgstr "A silence that does not demand adopting any affinity."

msgid "narrative.world.option.none.consequence"
msgstr "The presence allows the silence to remain."

# Q("perception", ...)
msgid "narrative.perception.title"
msgstr "What the new form recognises first"

msgid "narrative.perception.body"
msgstr ""
"Something begins to organise itself around your awareness.\n"
"It is not yet a complete body.\n"
"Still, one perception appears before the others."

msgid "narrative.perception.option.ardhen.label"
msgstr "Weight, resistance, and the effort required to move something."

msgid "narrative.perception.option.ardhen.consequence"
msgstr "The form learns effort before movement."

msgid "narrative.perception.option.eirune.label"
msgstr "Pulses, wounds and cycles that keep a form alive."

msgid "narrative.perception.option.eirune.consequence"
msgstr "The form recognises that being alive requires continuity."

msgid "narrative.perception.option.kovari.label"
msgstr "The rhythms, joints and failures that allow a system to be taken apart."

msgid "narrative.perception.option.kovari.consequence"
msgstr "The form distinguishes pieces where before there was only a whole."

msgid "narrative.perception.option.myrven.label"
msgstr "The gestures, contradictions and meanings that exist between identities."

msgid "narrative.perception.option.myrven.consequence"
msgstr "The form recognises that a face never contains a single reading."

# Q("orientation", ...)
msgid "narrative.orientation.title"
msgstr "The new form seeks orientation"

msgid "narrative.orientation.body"
msgstr ""
"The structure keeps completing itself.\n"
"Not to get lost, it must recognise a fundamental relation with what surrounds it."

msgid "narrative.orientation.option.vaelun.label"
msgstr "The distance between a place, a path and the possibility of returning."

msgid "narrative.orientation.option.vaelun.consequence"
msgstr "The form finds direction in the possibility of return."

msgid "narrative.orientation.option.orveth.label"
msgstr "The balance between what is needed, what is kept and what is given."

msgid "narrative.orientation.option.orveth.consequence"
msgstr "The form recognises a reserve and its possible recipient."

msgid "narrative.orientation.option.caelith.label"
msgstr "The connections that allow fragments to become knowledge."

msgid "narrative.orientation.option.caelith.consequence"
msgstr "The form links observations that on their own were not enough."

msgid "narrative.orientation.option.theryn.label"
msgstr "The emotional state that holds a group together or pulls it apart."

msgid "narrative.orientation.option.theryn.consequence"
msgstr "The form senses tension even before knowing a group."

# Q("threshold", ...)
msgid "narrative.threshold.title"
msgstr "The threshold resists"

msgid "narrative.threshold.body"
msgstr ""
"The exit toward the material plane begins to close.\n"
"It is not a creature nor a will.\n"
"It is a force that fills all the space you must cross."

msgid "narrative.threshold.option.support.label"
msgstr "Hold its pressure until the opening stabilises again."

msgid "narrative.threshold.option.support.consequence"
msgstr "The opening trembles, held by your resistance."

msgid "narrative.threshold.option.control.label"
msgstr "Set limits and force it to move within a controlled space."

msgid "narrative.threshold.option.control.consequence"
msgstr "The threshold gives way within limits it did not expect."

msgid "narrative.threshold.option.mobility.label"
msgstr "Follow its movement until you find a path around."

msgid "narrative.threshold.option.mobility.consequence"
msgstr "Resistance becomes a path."

msgid "narrative.threshold.option.precision.label"
msgstr "Wait until you understand the exact pattern of its weakness."

msgid "narrative.threshold.option.precision.consequence"
msgstr "The pattern appears just before it disappears."

msgid "narrative.threshold.option.assault.label"
msgstr "Cross it before it has time to close completely."

msgid "narrative.threshold.option.assault.consequence"
msgstr "The force reaches you late; you are already on the other side."

# Q("ground", ...)
msgid "narrative.ground.title"
msgstr "The weight under your feet"

msgid "narrative.ground.body"
msgstr ""
"Something appears below you.\n"
"It is still too far to call it ground.\n"
"For the first time you understand that the impact could destroy part of what you have kept."

msgid "narrative.ground.option.clarity.label"
msgstr "Protect the clarity of my awareness."

msgid "narrative.ground.option.clarity.consequence"
msgstr "Your memories close around a stable core."

msgid "narrative.ground.option.shared.label"
msgstr "Protect the object or fragment we shared."

msgid "narrative.ground.option.shared.consequence"
msgstr "The fragment occupies the centre of your fall."

msgid "narrative.ground.option.move.label"
msgstr "Keep the ability to move when everything ends."

msgid "narrative.ground.option.move.consequence"
msgstr "The form reserves movement for after the impact."

msgid "narrative.ground.option.mark.label"
msgstr "Leave a mark that lets me recognise the exact place of my arrival."

msgid "narrative.ground.option.mark.consequence"
msgstr "The point of impact acquires a coordinate and an intent."

# Q("unchanged", ...)
msgid "narrative.unchanged.title"
msgstr "What must not change"

msgid "narrative.unchanged.body"
msgstr ""
"The form is almost complete.\n"
"It will have another face, another voice, needs you have never known.\n"
"If everything else can change, something must remain recognisable."

msgid "narrative.unchanged.option.protect.label"
msgstr "What I decide to protect."

msgid "narrative.unchanged.option.protect.consequence"
msgstr "The new form finds a limit it is willing to hold."

msgid "narrative.unchanged.option.freedom.label"
msgstr "The freedom to choose who I can become."

msgid "narrative.unchanged.option.freedom.consequence"
msgstr "The form finishes closing without closing its possibilities."

msgid "narrative.unchanged.option.understand.label"
msgstr "The need to understand before accepting an answer."

msgid "narrative.unchanged.option.understand.consequence"
msgstr "The question remains even when the form stops changing."

msgid "narrative.unchanged.option.paths.label"
msgstr "The way I find paths even after losing them."

msgid "narrative.unchanged.option.paths.consequence"
msgstr "The terrain stops being a stain and starts looking like a place."

