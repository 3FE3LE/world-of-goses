<Project Sdk="Godot.NET.Sdk/4.7.1">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <TargetFramework Condition=" '$(GodotTargetPlatform)' == 'android' ">net9.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <RootNamespace>WorldofGoses</RootNamespace>
  </PropertyGroup>

  <!--
    The domain compiles into its own Godot-free assembly
    (src/WorldofGoses.Domain). Its sources still live under scripts/Domain/,
    so they must be removed from THIS project's default glob or they would
    compile twice. The ProjectReference is what the presentation layer sees.

    Consequence, and the reason this exists: `using Godot` under
    scripts/Domain/ no longer compiles. The boundary is the compiler's job
    now, not a reviewer's.
  -->
  <ItemGroup>
    <Compile Remove="scripts/Domain/**/*.cs" />
    <Compile Remove="scripts/Application/**/*.cs" />
    <ProjectReference Include="../src/WorldofGoses.Domain/WorldofGoses.Domain.csproj" />
    <ProjectReference Include="../src/WorldofGoses.Application/WorldofGoses.Application.csproj" />
    <!--
      Architecture Hardening A6: Persistence moved out of Domain into
      its own engine-free assembly. Presentation calls into it through
      the temporary `WorldPersistence` facade (load/save/migrate) and
      through `WorldPersistence.ApplyTo` / `WorldPersistence.FromSave`
      for the restore path that used to live on `CityWorld`.
    -->
    <ProjectReference Include="../src/WorldofGoses.Persistence/WorldofGoses.Persistence.csproj" />
  </ItemGroup>
</Project>
