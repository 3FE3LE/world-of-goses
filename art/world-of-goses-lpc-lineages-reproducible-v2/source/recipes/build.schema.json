{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "World of Goses lineage sprite build recipe",
  "type": "object",
  "required": ["version", "source_frame_size", "output_frame_size", "baseline", "scene_offset", "directions", "animations"],
  "properties": {
    "version": {"type": "integer", "minimum": 1},
    "package": {"type": "string", "minLength": 1},
    "package_version": {"type": "string", "minLength": 1},
    "source_frame_size": {"const": 64},
    "output_frame_size": {"const": 128},
    "baseline": {"$ref": "#/$defs/point"},
    "scene_offset": {"$ref": "#/$defs/point"},
    "directions": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"type": "integer", "minimum": 0}
    },
    "animations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "mode", "source", "frames", "fps", "loop"],
        "properties": {
          "name": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
          "mode": {"enum": ["sheet", "sheet_mirror"]},
          "source": {"type": "string", "minLength": 1},
          "frames": {"type": "integer", "minimum": 1},
          "fps": {"type": "number", "exclusiveMinimum": 0},
          "loop": {"type": "boolean"},
          "fallbacks": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "required": ["source", "columns"],
              "properties": {
                "source": {"type": "string", "minLength": 1},
                "columns": {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 0}}
              }
            }
          }
        },
        "additionalProperties": true
      }
    }
  },
  "$defs": {
    "point": {
      "type": "array",
      "prefixItems": [{"type": "integer"}, {"type": "integer"}],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    }
  },
  "additionalProperties": true
}
